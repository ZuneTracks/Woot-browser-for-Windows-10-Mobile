<Page
    x:Class="Woot.Uwp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{StaticResource PhonePageBrush}">
        <ScrollViewer>
            <StackPanel Margin="20,28">
                <Button Content="‹  BACK" Style="{StaticResource PhoneOutlineButtonStyle}" Click="BackButton_Click" HorizontalAlignment="Left" />
                <TextBlock Text="settings" FontSize="30" Foreground="{StaticResource PhonePrimaryTextBrush}" />
                <TextBlock Text="Your Woot API key is stored locally on this device and is never included in the app." Foreground="{StaticResource PhoneMutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,20" />
                <PasswordBox x:Name="ApiKeyBox" Header="Woot API key" PlaceholderText="Paste your API key" Foreground="{StaticResource PhonePrimaryTextBrush}" Background="{StaticResource PhoneCardBrush}" BorderBrush="{StaticResource PhoneMutedTextBrush}" Padding="10,7" Margin="0,4,0,12" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="SAVE" Style="{StaticResource PhoneButtonStyle}" Click="SaveButton_Click" />
                    <Button Content="CLEAR" Style="{StaticResource PhoneOutlineButtonStyle}" Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock Text="APPEARANCE" Foreground="{StaticResource PhoneMutedTextBrush}" Margin="0,20,0,2" />
                <ToggleSwitch x:Name="DarkThemeSwitch" Header="Dark mode" Toggled="DarkThemeSwitch_Toggled" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource PhoneMutedTextBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
                <Button Content="ABOUT" Style="{StaticResource PhoneOutlineButtonStyle}" Click="AboutButton_Click" HorizontalAlignment="Left" Margin="0,28,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
